# BStalk3r 페이퍼 계좌 (Alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Bloasis 페이퍼 계좌 (Alpaca — bstalk3r와 다른 계좌)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# Bloasis 백테스트 기준선 로드용 SQLite (없으면 기준선 생략)
# 절대경로로 채워라 — .env 는 $HOME 같은 변수를 확장하지 않는다.
BLOASIS_DB_PATH=

# 로컬 LLM 해설 (Mode A). Ollama 0.15.5는 qwen3-coder:30b만 로드 가능
LLM_MODEL=qwen3-coder:30b
OLLAMA_HOST=http://localhost:11434
LLM_TIMEOUT_S=180

# 텔레그램 푸시 (Mode A)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
